{
  "name": "photography-studio-management",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "test": "npm test -w backend",
    "verify": "npm run verify -w backend",
    "verify:browser": "npm run verify:browser -w backend",
    "db:init": "npm run db:init -w backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "concurrently": "^9.2.0",
    "prettier": "^3.10.1"
  }
}
